// Deploys the static Astro build as a Worker with static assets — no Worker
// script. Committing this file is what stops Wrangler's application detection,
// which refuses to run at the root of a pnpm workspace.
{
  "name": "typescript-course",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Built by `pnpm --filter elearning build`, which reads ../exercises, so the
    // build and deploy both run from the repo root.
    "directory": "./src/elearning/dist",
    "not_found_handling": "404-page"
  }
}
